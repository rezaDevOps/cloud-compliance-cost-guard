{
  "meta": {
    "instanceId": "8c8c5237b8e37b006a7adce87f4b759ef0d60cdc3b7b7d8500ed7b65e2bb7cd1"
  },
  "nodes": [
    {
      "parameters": {
        "path": "cloudguard-webhook",
        "httpMethod": "=POST",
        "options": {}
      },
      "id": "7f0e0d1f-5b3a-4c8d-b4e9-2a3c5d6e7f8a",
      "name": "CloudGuard Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        400,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "=POST",
        "url": "=http://scanner:8080/scan",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "rawBody": false,
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "8a1f2e3d-6c4b-5d7e-a9f8-3b4c5d6e7f8b",
      "name": "Call Scanner API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        600,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "agent": "conversationalAgent",
        "promptType": "define",
        "text": "=You are a cloud cost optimization expert AI. Analyze the following AWS cost scan results:\n\n{{ JSON.stringify($json, null, 2) }}\n\nYour tasks:\n1. Calculate TOTAL potential monthly savings from all findings\n2. Prioritize recommendations by savings amount (highest first)\n3. Provide step-by-step remediation guides for top 3 savings opportunities\n4. Identify quick wins (easy fixes with good savings)\n5. Suggest reserved instance or spot instance opportunities\n6. Calculate ROI and implementation effort for each recommendation\n\nReturn your analysis in JSON format with these fields:\n- status: 'success' or 'error'\n- total_monthly_savings: total potential savings across all findings\n- findings: array of findings with enhanced descriptions\n- recommendations: array sorted by savings (highest first), each with: {action, savings, effort, roi, steps}\n- quick_wins: array of easy fixes with good ROI\n- reserved_instance_candidates: array of instances that could benefit from RI\n- spot_instance_candidates: array of workloads suitable for spot instances\n- summary: executive summary focused on cost savings",
        "options": {
          "systemMessage": "You are an expert cloud cost optimization consultant specializing in AWS, Azure, and GCP. You help businesses reduce cloud spending through actionable recommendations. Focus on ROI, implementation effort, and real-world savings. Always provide specific dollar amounts and step-by-step guides."
        }
      },
      "id": "2b3c4d5e-6f7a-8b9c-0d1e-2f3a4b5c6d7e",
      "name": "AI Cost Optimizer",
      "type": "n8n-nodes-base.agent",
      "typeVersion": 1,
      "position": [
        800,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "=PATCH",
        "url": "={{ $env.SUPABASE_URL || 'https://your-project.supabase.co' }}/rest/v1/scan_results",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "id",
              "value": "=eq.{{ $('CloudGuard Webhook').item.json.scan_id }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "rawBody": false,
        "jsonBody": "={{ JSON.stringify({\n  status: $json.status || 'completed',\n  findings: $json.findings || [],\n  severity_counts: {\n    critical: $json.findings ? $json.findings.filter(f => f.severity === 'critical').length : 0,\n    high: $json.findings ? $json.findings.filter(f => f.severity === 'high').length : 0,\n    medium: $json.findings ? $json.findings.filter(f => f.severity === 'medium').length : 0,\n    low: $json.findings ? $json.findings.filter(f => f.severity === 'low').length : 0\n  },\n  recommendations: $json.recommendations || [],\n  ai_analysis: {\n    risk_score: $json.risk_score || 0,\n    top_issues: $json.top_issues || [],\n    summary: $json.summary || ''\n  }\n}) }}",
        "options": {}
      },
      "id": "1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
      "name": "Update Supabase Scan Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1000,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "alert_type",
              "value": "=security_scan"
            }
          ],
          "number": [
            {
              "name": "critical_count",
              "value": "={{ $json.findings ? $json.findings.filter(f => f.severity === 'critical').length : 0 }}"
            },
            {
              "name": "total_findings",
              "value": "={{ $json.findings ? $json.findings.length : 0 }}"
            }
          ],
          "boolean": [
            {
              "name": "has_critical",
              "value": "={{ ($json.findings ? $json.findings.filter(f => f.severity === 'critical').length : 0) > 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "9b2a3f4e-7d5c-6e8f-ba09-4c5d6e7f8a9c",
      "name": "Process Scan Results",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.has_critical }}",
              "value2": true
            }
          ]
        }
      },
      "id": "ac3b4a5f-8e6d-7f9a-cb1a-5d6e7f8a9bad",
      "name": "Check Critical",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1400,
        300
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "method": "=POST",
        "url": "={{ $vars.SLACK_WEBHOOK_URL || 'https://hooks.slack.com/services/YOUR/WEBHOOK/URL' }}",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "rawBody": false,
        "jsonBody": "={{ JSON.stringify({\n  \"text\": \"🚨 Critical Security Alert from CloudGuard\",\n  \"attachments\": [{\n    \"color\": \"danger\",\n    \"fields\": [\n      {\n        \"title\": \"Critical Issues\",\n        \"value\": String($json.critical_count),\n        \"short\": true\n      },\n      {\n        \"title\": \"Total Findings\",\n        \"value\": String($json.total_findings),\n        \"short\": true\n      }\n    ]\n  }]\n}) }}",
        "options": {
          "ignoreSSLIssues": true
        }
      },
      "id": "bd4c5b6a-9f7e-8a0b-dc2b-6e7f8a9cbaed",
      "name": "Send Slack Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1600,
        200
      ],
      "notesInFlow": false
    },
    {
      "parameters": {
        "content": "### CloudGuard Security Scanner\n\n**Setup Steps:**\n1. Activate this workflow\n2. Set SLACK_WEBHOOK_URL variable\n3. Ensure scanner runs on port 8080\n4. Test webhook: `/cloudguard-webhook`",
        "height": 180,
        "width": 300
      },
      "id": "ce5d6c7b-aa8f-9b1c-ed3c-7f8a9bacbdfe",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        380,
        480
      ]
    }
  ],
